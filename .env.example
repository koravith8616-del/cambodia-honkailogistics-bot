# ==============================================================================
# CAMBODIA LOGISTICS & SUPPLY CHAIN TELEGRAM AUTOMATION BOT - CONFIGURATION
# ==============================================================================

# 1. Telegram Bot Token (Obtain from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. Telegram Target Channel / Group ID (Optional: e.g., @cambodia_logistics_intel or -1001234567890)
# Leave blank or set if you want the bot to auto-broadcast to a public channel
TELEGRAM_CHANNEL_ID=

# 3. Bot Admin Telegram User ID (Numeric ID from @userinfobot for admin commands like /admin_broadcast)
ADMIN_USER_IDS=

# 4. Google Gemini API Key (For deep research AI analysis & bilingual translation)
# If not provided, the bot uses high-grade deterministic rule-based market intelligence
GEMINI_API_KEY=

# 5. Automated 3x Daily Broadcasting Schedule (Cambodia Time ICT / UTC+7)
# Slot 1 (08:00 AM ICT): Ocean Freight & Port Operations (Sihanoukville PAS / PPAP)
SCHEDULE_SLOT_1=08:00
# Slot 2 (13:30 PM ICT): Cross-Border Trucking, Expressway & Borders (Bavet / Poipet)
SCHEDULE_SLOT_2=13:30
# Slot 3 (18:00 PM ICT): Air Cargo, Factory GFT Logistics & GDCE Customs Compliance
SCHEDULE_SLOT_3=18:00

# 6. Default Content Language: "trilingual" (Khmer + English + Chinese), "en", "km", or "zh"
DEFAULT_LANGUAGE=trilingual

# 7. Database Path
DB_PATH=cambodia_logistics.db
